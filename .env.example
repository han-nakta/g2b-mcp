# Optional: artifact directory override for local development.
# Defaults to ./artifacts when running from the repository root.
G2B_ARTIFACT_DIR=./artifacts

# HTTP/Streamable MCP server settings.
HOST=127.0.0.1
PORT=8000

# This public alpha does not require or read a G2B/data.go.kr API key by default.
# If opt-in live-read mode is enabled with --enable-live-fetch, keep the user's own key in
# a local-only environment variable such as G2B_SERVICE_KEY. Do not commit real values.
# G2B_SERVICE_KEY=
