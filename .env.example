# Optional: artifact directory override for local development.
# Defaults to ./artifacts when running from the repository root.
G2B_ARTIFACT_DIR=./artifacts

# HTTP/Streamable MCP server settings.
HOST=127.0.0.1
PORT=8000

# This public package does not require or read G2B API keys by default.
# Keep live API credentials in your private operator environment only.
# G2B_*_API_KEY=do-not-put-real-keys-in-this-file
